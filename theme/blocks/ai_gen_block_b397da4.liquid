{% doc %}
  @prompt
    Utwórz formularz kontaktowy, który będzie wyrównany do lewej strony, jak inne sekcje. Wielkość fontów też ma być jak w innych sekcjach.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
  }

  .ai-contact-form__wrapper-{{ ai_gen_id }} {
    max-width: 800px;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    font-size: calc(var(--font-heading-scale) * 2.4rem);
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    color: {{ block.settings.heading_color }};
  }

  .ai-contact-form__subtext-{{ ai_gen_id }} {
    margin: 0 0 32px;
    font-size: calc(var(--font-body-scale) * 1.6rem);
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form__fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    font-size: calc(var(--font-body-scale) * 1.4rem);
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: calc(var(--font-body-scale) * 1.6rem);
    font-family: var(--font-body-family);
    border: {{ settings.inputs_border_thickness }}px solid rgba({{ block.settings.text_color | color_extract: 'red' }}, {{ block.settings.text_color | color_extract: 'green' }}, {{ block.settings.text_color | color_extract: 'blue' }}, {{ settings.inputs_border_opacity | divided_by: 100.0 }});
    border-radius: {{ settings.inputs_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: 150px;
    resize: vertical;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_color }};
    outline-offset: 2px;
  }

  .ai-contact-form__button-{{ ai_gen_id }} {
    padding: 14px 32px;
    font-size: calc(var(--font-body-scale) * 1.6rem);
    font-family: var(--font-body-family);
    font-weight: 500;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ settings.buttons_border_thickness }}px solid {{ block.settings.button_color }};
    border-radius: {{ settings.buttons_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .ai-contact-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: 24px;
    background-color: rgba(0, 128, 96, 0.1);
    border-left: 4px solid #008060;
    color: #008060;
    font-size: calc(var(--font-body-scale) * 1.6rem);
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: 24px;
    background-color: rgba(216, 44, 13, 0.1);
    border-left: 4px solid #D82C0D;
    color: #D82C0D;
    font-size: calc(var(--font-body-scale) * 1.6rem);
  }

  .ai-contact-form__field-error-{{ ai_gen_id }} {
    font-size: calc(var(--font-body-scale) * 1.4rem);
    color: #D82C0D;
    margin-top: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form__heading-{{ ai_gen_id }} {
      font-size: calc(var(--font-heading-scale) * 2rem);
    }

    .ai-contact-form__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-contact-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-form__wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-contact-form__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
    {% endif %}

    {%- form 'contact' -%}
      {% if form.posted_successfully? %}
        <div class="ai-contact-form__success-{{ ai_gen_id }}" id="ai-contact-form-success-{{ ai_gen_id }}">
          {{ block.settings.success_message }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="ai-contact-form__error-{{ ai_gen_id }}" id="ai-contact-form-error-{{ ai_gen_id }}">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="ai-contact-form__fields-{{ ai_gen_id }}">
        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-name-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.name_label }}
          </label>
          <input
            type="text"
            id="ai-contact-name-{{ ai_gen_id }}"
            name="contact[name]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            value="{% if form.name %}{{ form.name }}{% endif %}"
            placeholder="{{ block.settings.name_placeholder }}"
            {% if form.errors contains 'name' %}
              aria-invalid="true"
              aria-describedby="ai-contact-name-error-{{ ai_gen_id }}"
            {% endif %}
          >
          {% if form.errors contains 'name' %}
            <span id="ai-contact-name-error-{{ ai_gen_id }}" class="ai-contact-form__field-error-{{ ai_gen_id }}">
              {{ form.errors.translated_fields.name | capitalize }} {{ form.errors.messages.name }}
            </span>
          {% endif %}
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-email-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.email_label }}
          </label>
          <input
            type="email"
            id="ai-contact-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            value="{% if form.email %}{{ form.email }}{% endif %}"
            placeholder="{{ block.settings.email_placeholder }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ai-contact-email-error-{{ ai_gen_id }}"
            {% endif %}
          >
          {% if form.errors contains 'email' %}
            <span id="ai-contact-email-error-{{ ai_gen_id }}" class="ai-contact-form__field-error-{{ ai_gen_id }}">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </span>
          {% endif %}
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-phone-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.phone_label }}
          </label>
          <input
            type="tel"
            id="ai-contact-phone-{{ ai_gen_id }}"
            name="contact[phone]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            value="{% if form.phone %}{{ form.phone }}{% endif %}"
            placeholder="{{ block.settings.phone_placeholder }}"
            autocomplete="tel"
            {% if form.errors contains 'phone' %}
              aria-invalid="true"
              aria-describedby="ai-contact-phone-error-{{ ai_gen_id }}"
            {% endif %}
          >
          {% if form.errors contains 'phone' %}
            <span id="ai-contact-phone-error-{{ ai_gen_id }}" class="ai-contact-form__field-error-{{ ai_gen_id }}">
              {{ form.errors.translated_fields.phone | capitalize }} {{ form.errors.messages.phone }}
            </span>
          {% endif %}
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-message-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.message_label }}
          </label>
          <textarea
            id="ai-contact-message-{{ ai_gen_id }}"
            name="contact[body]"
            class="ai-contact-form__textarea-{{ ai_gen_id }}"
            placeholder="{{ block.settings.message_placeholder }}"
            required
            {% if form.errors contains 'body' %}
              aria-invalid="true"
              aria-describedby="ai-contact-message-error-{{ ai_gen_id }}"
            {% endif %}
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          {% if form.errors contains 'body' %}
            <span id="ai-contact-message-error-{{ ai_gen_id }}" class="ai-contact-form__field-error-{{ ai_gen_id }}">
              {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}
            </span>
          {% endif %}
        </div>

        <button type="submit" class="ai-contact-form__button-{{ ai_gen_id }}">
          {{ block.settings.button_label }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Have a question? We're here to help.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for contacting us. We'll get back to you as soon as possible."
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "inline_richtext",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "inline_richtext",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "inline_richtext",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "inline_richtext",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "inline_richtext",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "inline_richtext",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "Your phone number"
    },
    {
      "type": "inline_richtext",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "inline_richtext",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Write your message here..."
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#ff850c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover",
      "default": "#e67600"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
